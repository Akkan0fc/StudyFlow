# Optional. The constraint engine and all local features work without an API key.
# Copy this file to .env and configure OpenAI. Never commit .env.
PORT=4310
# Set ALLOWED_HOSTS=* or comma-separated domains to allow external/container deployments
ALLOWED_HOSTS=*
# Choose a currently available structured-output model from your provider account.
AI_MODEL=
OPENAI_API_KEY=
